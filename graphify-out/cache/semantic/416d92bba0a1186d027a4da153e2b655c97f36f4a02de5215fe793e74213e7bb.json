{"nodes": [{"id": "architecture_token_contract", "label": "Contrato de tokens", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "design/tokens.json es la \u00fanica fuente de verdad de dise\u00f1o. De el se generan tres archivos que nunca se editan a mano; cuando el diseno cambia se regeneran."}, {"id": "architecture_no_hardcoded_literals", "label": "Regla de cero literales en UI", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ningun color, tamano de fuente, radio, espaciado ni duracion hardcodeado dentro de un widget. Un literal en codigo de UI es un bug, no una preferencia."}, {"id": "architecture_semaphore_split", "label": "Semaforo partido en dos capas", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los umbrales de faltas son Dart puro y viven en el dominio; los colores son Flutter y viven en el tema. Asi la logica de faltas se testea sin binding de Flutter."}, {"id": "architecture_pure_domain_layer", "label": "Dominio en Dart puro", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "domain/ esta fuera de features/ porque es logica compartida y para que sea fisicamente evidente cuando alguien intente importar Flutter ahi."}, {"id": "architecture_feature_based_layers", "label": "Arquitectura por features", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una carpeta por feature (data/application/presentation), no por capa tecnica."}, {"id": "architecture_reduced_motion_degradation", "label": "Degradacion por movimiento reducido", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MotionGuard lee MediaQuery.disableAnimations y degrada: duracion al fade de 180 ms, curva lineal, desplazamiento y escalonado a cero, loops congelados en el primer fotograma (no ocultos), lista disable omitida por completo."}, {"id": "architecture_single_looping_animation", "label": "Unica animacion en loop", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La respiracion del anillo es la unica animacion en loop de una pantalla de trabajo: va envuelta en RepaintBoundary y se detiene cuando la card no esta visible."}, {"id": "architecture_offline_first", "label": "Offline primero", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drift sobre SQLite desde el primer dia. Supabase entra en la Fase 6 y no condiciona nada del esquema actual."}, {"id": "architecture_minutes_since_midnight", "label": "Horas como minutos desde medianoche", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una clase de martes 10:00 no tiene fecha propia; un DateTime con fecha falsa arrastra zona horaria y horario de verano a un dato que no los tiene."}, {"id": "architecture_materialized_sessions", "label": "Sesiones materializadas", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada SessionInstance lleva estado propio y ese estado debe sobrevivir a que cambie el horario. El indice unico (session_id, fecha) hace idempotente la regeneracion."}, {"id": "architecture_iso_weekday", "label": "Dia de semana ISO 8601", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 = lunes ... 7 = domingo, igual que DateTime.weekday. Cualquier otra convencion genera off-by-one al mezclar las dos."}, {"id": "architecture_stable_subject_color_index", "label": "Color de materia por indice", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se guarda color_index (0-7) y se resuelve contra SubjectPalette: la materia se ve igual en cualquier dispositivo, sobrevive a un cambio de paleta y nunca es aleatoria."}, {"id": "architecture_mascot_host_gate", "label": "Compuerta de host de la mascota", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MascotView exige host sin valor por defecto: si no sabes en que pantalla estas, no deberias estar poniendo la mascota. En debug un host fuera de la lista revienta con un assert."}, {"id": "architecture_phase_roadmap", "label": "Hoja de fases F0-F6", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F0 tema y tokens (hecho), F1 datos y vistas Hoy/Semana (esqueleto), F2 notas y asistencia (dominio hecho, UI pendiente), F3 PDF, F4 ubicacion (sin diseno), F5 widgets Glance, F6 sync (sin diseno)."}], "edges": [{"source": "architecture_token_contract", "target": "tool_gen_tokens", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AR